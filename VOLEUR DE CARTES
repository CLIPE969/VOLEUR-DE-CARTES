);

}

function nouvelle(){

afficherResultatNouvellePartie();

}
function afficherResultatNouvellePartie(){

let totalPoints=0;
let liste="";

for(let mot of memoA){

let longueur=mot.length;

if(longueur>=5 && longueur<=10){

let points=longueur*2;
totalPoints+=points;

liste+="<div>"+mot.toUpperCase()+" — "+points+" points</div>";

}

}

if(liste==""){
liste="<div>Aucun mot de 5 à 10 lettres trouvé.</div>";
}

let fond=document.createElement("div");
fond.id="resultatNouvellePartie";

fond.innerHTML=
"<div class='resultatBoite'>"+
"<div class='resultatBravo'>BRAVO !</div>"+
"<div class='resultatPoints'>"+totalPoints+" points</div>"+
"<div class='listeMots'>"+liste+"</div>"+
"<button class='boutonFermerResultat' onclick='fermerResultatNouvellePartie();'>OK</button>"+
"</div>";

document.body.appendChild(fond);

}

function fermerResultatNouvellePartie(){

let popupResultat=document.getElementById("resultatNouvellePartie");

if(popupResultat){
popupResultat.remove();
}

memoA=[];

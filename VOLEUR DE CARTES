font-size:28px;
}

button{
height:42px;
padding:2px 6px;
font-size:16px;
margin:2px;
}

#jeu{
background:#4F83FA;
border:1px solid white;
display:inline-block;
padding:10px;
margin-top:5px;
}

.aide{
font-style:italic;
border:1px dashed black;
display:inline-block;
padding:2px 6px;
margin-bottom:10px;
cursor:pointer;
}

.piocheZone{
background:#4F83FA ;
border:2px white;
padding:5px;
margin:5px;
}

.piocheTitre{
font-style:italic;
margin-bottom:5px;
border-bottom:1px solid black;
padding-bottom:3px;
}

.pioche{
display:flex;
justify-content:center;
gap:4px;
margin-top:5px;
}

.zoneJeu{
display:flex;
gap:10px;
justify-content:center;
margin-top:5px
}

.Page 1{
background:white;
border:10px solid black;
padding:5px;
margin-top:5px
}

.Page 2{
background:white;
border:10px solid black;
padding:5px;
margin-top:5px
}

.grille{
display:grid;
grid-template-columns:repeat(5,30px);
gap:3px;
}

.carte{
width:28px;
height:45px;
border:2px solid black;
border-radius:8px;
background:white;
display:flex;
align-items:center;
justify-content:center;
font-weight:bold;
font-size:22px;
cursor:pointer;
}

.memo{
margin-top:8px;
font-size:12px;
font-style:italic;
}

.memoBox{
border:1px solid black;
background:white;
padding:3px;
margin:2px;
min-height:18px;
}

#popup{
position:absolute;
top:50%;
left:50%;
transform:translate(-50%,-50%);
box-sizing:border-box;
max-width:calc(100vw - 30px);
background:white;
border-radius:14px;
padding:10px;
border:2px solid black;
color:black;
width:300px;
font-size:14px;
line-height:1.3em;
}

#popupFond{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,0.2);
display:none;
}

</style>

<style id="corrections-telephone">
.commandes{
  width:100%;
  text-align:center;
  box-sizing:border-box;
}
.ligneNouvelle,
.ligneActions{
  display:flex;
  justify-content:center;
  align-items:center;
  width:100%;
  box-sizing:border-box;
}
.ligneActions{
  gap:4px;
  flex-wrap:nowrap;
}

@media (max-width:600px){
  /* Téléphone : largeur naturelle du jeu ; aucune carte latérale n'est coupée. */
  html, body{
    width:100% !important;
    min-width:0 !important;
    margin:0 !important;
    padding:0 !important;
    overflow-x:auto !important;
  }

  body{
    display:block !important;
    text-align:center !important;
  }

  #jeu{
    display:inline-block !important;
    width:max-content !important;
    max-width:none !important;
    margin:2px auto 0 auto !important;
    box-sizing:border-box !important;
    overflow:visible !important;
    transform:none !important;
    left:auto !important;
    right:auto !important;
  }

  .zoneJeu{
    width:auto !important;
    justify-content:center !important;
    gap:10px !important;
    overflow:visible !important;
  }

  .grilleVoleur{
    flex:none !important;
  }

  .ligneActions{
    gap:3px !important;
    flex-wrap:nowrap !important;
  }

  .memo{
    margin-top:18px !important;
    font-size:18px !important;
    line-height:1.25 !important;
  }

  .memoBox{
    font-size:18px !important;
    line-height:1.25 !important;
    min-height:24px !important;
    padding:4px !important;
  }
}
</style>
<style id="interface-voleur-cartes">
.grilleVoleur{
display:grid;
grid-template-columns:repeat(10,30px);
grid-auto-rows:45px;
gap:3px;
justify-content:center;
}
.grilleVoleur .carte{
box-sizing:border-box;
width:28px;
height:45px;
}
@media(max-width:600px){
.grilleVoleur{
grid-template-columns:repeat(10,30px);
grid-auto-rows:45px;
gap:2px;
}
}
</style>


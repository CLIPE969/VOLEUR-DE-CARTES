var dico = dicoTexte.split(/\s+/);

function creerGrille(id){

let g=document.getElementById(id);

for(let i=0;i<50;i++){

let c=document.createElement("div");
c.className="carte";

c.onclick=function(){
clicCarte(c);
};

g.appendChild(c);

}

}

creerGrille("grilleA");

function piocher(){

let p=document.getElementById("pioche");
p.innerHTML="";

for(let i=0;i<7;i++){

let l=sac[Math.floor(Math.random()*sac.length)];

let c=document.createElement("div");
c.className="carte";
c.innerText=l;

c.onclick=function(){
clicCarte(c);
};

p.appendChild(c);

}

}

piocher();

function clicCarte(c){

if(lettreMain==null){

if(c.innerText=="") return;

lettreMain=c.innerText;
c.innerText="";

}
else{

if(c.innerText==""){

c.innerText=lettreMain;
lettreMain=null;

}

}

}

function nouvellePioche(){

if(piocheUtilisee){

popup("Valider votre jeu !");
return;

}

piocheUtilisee=true;
piocher();

}

function lireMots(grilleId){

let g=document.getElementById(grilleId);
let cartes=g.children;
let mots=[];

for(let l=0;l<5;l++){

let mot="";

for(let c=0;c<10;c++){

let i=l*10+c;
let t=cartes[i].innerText.toUpperCase();

if(t!=""){
mot+=t;
}else{
if(mot.length>=3) mots.push(mot);
mot="";
}

}

if(mot.length>=3) mots.push(mot);

}

return mots;

}

function verifierDico(mots){

for(let m of mots){

if(m.length>=3 && !dico.includes(m)){
popup("mot inconnu : "+m);
return false;
}

}

return true;

}

function ajouterMemo(mots){

for(let m of mots){

if(m.length>=3 && !memoA.includes(m)){
memoA.push(m);
}

}

afficherMemo();

}

function afficherMemo(){

memoA.sort();

document.getElementById("memoA").innerText=memoA.join(" ");

}

function valider(){

let mots=lireMots("grilleA");

if(mots.length>0){

if(!verifierDico(mots)){
return;
}

ajouterMemo(mots);

}

piocheUtilisee=false;

popup("Nouvelle pioche!");

}

function popup(t){

popupText.innerText=t;
popupFond.style.display="block";

}

function fermer(){

popupFond.style.display="none";

}

